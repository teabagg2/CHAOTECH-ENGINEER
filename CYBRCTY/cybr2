
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local SaveStore = DataStoreService:GetDataStore("CyberCity_Save_V2")

local STARTING_CREDITS = 500
local BUSINESS_COST = 250
local BUSINESS_INCOME = 25
local INCOME_INTERVAL = 5
local AUTOSAVE_INTERVAL = 60

local playerPlots = {}
local ownedBusinesses = {}
local loadedPlayers = {}
local savingPlayers = {}
local nextPlot = 0

local function makePart(parent, name, size, position, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Parent = parent
	return part
end

local function addSign(part, text, textColor)
	local gui = Instance.new("BillboardGui")
	gui.Name = "SignGui"
	gui.Size = UDim2.new(0, 260, 0, 60)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = textColor or Color3.fromRGB(0, 220, 255)
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.35
	label.Parent = gui
	return gui
end

local function createBusiness(plot, origin)
	local business = Instance.new("Folder")
	business.Name = "ServerBusiness"
	business.Parent = plot

	local cyan = Color3.fromRGB(0, 220, 255)
	local purple = Color3.fromRGB(155, 45, 255)
	local dark = Color3.fromRGB(15, 20, 42)

	makePart(business, "Server HQ", Vector3.new(14, 10, 12), origin + Vector3.new(0, 5.6, -8), dark, Enum.Material.Metal)
	makePart(business, "HQ Roof", Vector3.new(15, 0.5, 13), origin + Vector3.new(0, 10.85, -8), cyan, Enum.Material.Neon)
	makePart(business, "Front Glass", Vector3.new(9, 5, 0.25), origin + Vector3.new(0, 5.7, -1.87), cyan, Enum.Material.Glass)
	makePart(business, "Left Neon Panel", Vector3.new(0.3, 8, 9), origin + Vector3.new(-7.2, 5.8, -8), purple, Enum.Material.Neon)
	makePart(business, "Right Neon Panel", Vector3.new(0.3, 8, 9), origin + Vector3.new(7.2, 5.8, -8), cyan, Enum.Material.Neon)

	local signPart = makePart(business, "Business Sign", Vector3.new(8, 1, 0.4), origin + Vector3.new(0, 8.5, -1.7), dark, Enum.Material.Metal)
	addSign(signPart, "CYBER SERVER HQ", cyan)

	local infoPart = makePart(business, "Income Display", Vector3.new(5, 1, 0.4), origin + Vector3.new(0, 3, -1.7), dark, Enum.Material.Metal)
	addSign(infoPart, "+$" .. BUSINESS_INCOME .. " / " .. INCOME_INTERVAL .. " SEC", Color3.fromRGB(100, 255, 140))
end

local function createCityDecor(plot, origin)
	local cyan = Color3.fromRGB(0, 220, 255)
	local purple = Color3.fromRGB(150, 40, 255)
	local dark = Color3.fromRGB(18, 24, 48)
	local glass = Color3.fromRGB(25, 55, 95)

	local function buildTower(name, x, z, height, width, color)
		makePart(plot, name, Vector3.new(width, height, width), origin + Vector3.new(x, height / 2 + 0.6, z), dark, Enum.Material.Metal)
		makePart(plot, name .. " Roof Light", Vector3.new(width + 1, 0.4, width + 1), origin + Vector3.new(x, height + 0.8, z), color, Enum.Material.Neon)

		for floor = 1, math.floor(height / 5) do
			local y = floor * 5 + 0.6

			for _, side in ipairs({-1, 1}) do
				makePart(plot, name .. " Window", Vector3.new(width * 0.65, 1.8, 0.25), origin + Vector3.new(x, y, z + side * (width / 2 + 0.13)), glass, Enum.Material.Neon)
			end

			makePart(plot, name .. " Side Window", Vector3.new(0.25, 1.8, width * 0.65), origin + Vector3.new(x + width / 2 + 0.13, y, z), color, Enum.Material.Neon)
		end
	end

	buildTower("East Skyline Tower", 22, -21, 24, 8, cyan)
	buildTower("West Skyline Tower", -22, -21, 32, 9, purple)
	buildTower("East Front Tower", 22, 20, 18, 7, purple)
	buildTower("West Front Tower", -22, 20, 22, 7, cyan)

	for i = -2, 2 do
		makePart(plot, "Road Light Strip", Vector3.new(0.25, 0.15, 10), origin + Vector3.new(i * 3, 0.72, 0), i % 2 == 0 and cyan or purple, Enum.Material.Neon)
	end

	local welcome = makePart(plot, "CYBER CITY Welcome Sign", Vector3.new(16, 5, 1), origin + Vector3.new(0, 5, 27), dark, Enum.Material.Metal)
	addSign(welcome, "CYBER CITY", cyan)

	makePart(plot, "Welcome Sign Neon Frame", Vector3.new(17, 0.3, 1.3), origin + Vector3.new(0, 7.6, 27), cyan, Enum.Material.Neon)
	makePart(plot, "Welcome Sign Base", Vector3.new(1, 4, 1), origin + Vector3.new(-7, 2.5, 27), purple, Enum.Material.Neon)
	makePart(plot, "Welcome Sign Base", Vector3.new(1, 4, 1), origin + Vector3.new(7, 2.5, 27), cyan, Enum.Material.Neon)
end

local function updatePurchaseButton(button, prompt, purchased)
	if purchased then
		button.Color = Color3.fromRGB(50, 220, 120)
		prompt.ActionText = "Already Purchased"
		prompt.ObjectText = "Server Business Owned"
		prompt.Enabled = false
	else
		button.Color = Color3.fromRGB(0, 220, 255)
		prompt.ActionText = "Buy Business"
		prompt.ObjectText = "Server HQ - $" .. BUSINESS_COST
		prompt.Enabled = true
	end
end

local function getPlayerData(player)
	local leaderstats = player:FindFirstChild("leaderstats")
	local credits = leaderstats and leaderstats:FindFirstChild("Credits")

	return {
		Credits = credits and credits.Value or STARTING_CREDITS,
		OwnsServer = ownedBusinesses[player.UserId] == true
	}
end

local function savePlayer(player)
	if not player or not player.Parent or not loadedPlayers[player.UserId] then
		return false
	end

	while savingPlayers[player.UserId] do
		task.wait(0.1)

		if not player.Parent then
			return false
		end
	end

	savingPlayers[player.UserId] = true

	local data = getPlayerData(player)
	local success = false

	for attempt = 1, 3 do
		local ok, result = pcall(function()
			return SaveStore:UpdateAsync("Player_" .. player.UserId, function(oldData)
				oldData = type(oldData) == "table" and oldData or {}
				oldData.Credits = data.Credits
				oldData.OwnsServer = data.OwnsServer
				return oldData
			end)
		end)

		if ok then
			success = true
			break
		else
			warn("Cyber City save failed for " .. player.Name .. " (attempt " .. attempt .. "): " .. tostring(result))
			task.wait(attempt * 2)
		end
	end

	savingPlayers[player.UserId] = nil
	return success
end

local function createPlot(player)
	nextPlot += 1

	local plotIndex = nextPlot - 1
	local origin = Vector3.new((plotIndex % 4) * 90, 0, math.floor(plotIndex / 4) * 90)

	local plot = Instance.new("Folder")
	plot.Name = player.Name .. "_CyberPlot"
	plot.Parent = workspace

	playerPlots[player.UserId] = plot

	makePart(plot, "Plot Floor", Vector3.new(60, 1, 60), origin, Color3.fromRGB(22, 28, 45), Enum.Material.Metal)

	local cyan = Color3.fromRGB(0, 220, 255)
	local purple = Color3.fromRGB(150, 40, 255)

	makePart(plot, "Front Border", Vector3.new(60, 0.5, 0.5), origin + Vector3.new(0, 0.8, 30), cyan, Enum.Material.Neon)
	makePart(plot, "Back Border", Vector3.new(60, 0.5, 0.5), origin + Vector3.new(0, 0.8, -30), purple, Enum.Material.Neon)
	makePart(plot, "Left Border", Vector3.new(0.5, 0.5, 60), origin + Vector3.new(-30, 0.8, 0), purple, Enum.Material.Neon)
	makePart(plot, "Right Border", Vector3.new(0.5, 0.5, 60), origin + Vector3.new(30, 0.8, 0), cyan, Enum.Material.Neon)

	createCityDecor(plot, origin)

	local citySign = makePart(plot, "Player City Sign", Vector3.new(12, 2, 0.5), origin + Vector3.new(0, 2.5, 23), Color3.fromRGB(15, 20, 42), Enum.Material.Metal)
	addSign(citySign, player.Name .. "'S CITY", cyan)

	local button = makePart(plot, "Purchase Button", Vector3.new(8, 1, 8), origin + Vector3.new(0, 1.5, 8), cyan, Enum.Material.Neon)
	addSign(button, "BUY SERVER HQ $" .. BUSINESS_COST, Color3.fromRGB(255, 255, 255))

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PurchasePrompt"
	prompt.ActionText = "Buy Business"
	prompt.ObjectText = "Server HQ - $" .. BUSINESS_COST
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = button

	local alreadyOwned = ownedBusinesses[player.UserId] == true
	updatePurchaseButton(button, prompt, alreadyOwned)

	if alreadyOwned then
		createBusiness(plot, origin)
	end

	prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer ~= player then
			return
		end

		if ownedBusinesses[player.UserId] then
			return
		end

		local leaderstats = player:FindFirstChild("leaderstats")
		local credits = leaderstats and leaderstats:FindFirstChild("Credits")

		if not credits or credits.Value < BUSINESS_COST then
			return
		end

		credits.Value -= BUSINESS_COST
		ownedBusinesses[player.UserId] = true

		createBusiness(plot, origin)
		updatePurchaseButton(button, prompt, true)

		task.spawn(function()
			if not savePlayer(player) then
				warn("Cyber City could not immediately save the purchase for " .. player.Name)
			end
		end)
	end)

	return origin
end

local function loadPlayer(player)
	local creditsValue = STARTING_CREDITS
	local ownsServer = false
	local loadedSuccessfully = false

	for attempt = 1, 3 do
		local ok, data = pcall(function()
			return SaveStore:GetAsync("Player_" .. player.UserId)
		end)

		if ok then
			loadedSuccessfully = true

			if type(data) == "table" then
				if type(data.Credits) == "number" then
					creditsValue = math.max(0, math.floor(data.Credits))
				end

				ownsServer = data.OwnsServer == true
			end

			break
		else
			warn("Cyber City load failed for " .. player.Name .. " (attempt " .. attempt .. "): " .. tostring(data))
			task.wait(attempt * 2)
		end
	end

	if not player.Parent then
		return
	end

	if not loadedSuccessfully then
		warn("Data could not be loaded for " .. player.Name .. ". Saving is disabled for this session to protect existing data.")
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local credits = Instance.new("IntValue")
	credits.Name = "Credits"
	credits.Value = creditsValue
	credits.Parent = leaderstats

	ownedBusinesses[player.UserId] = ownsServer
	loadedPlayers[player.UserId] = true

	local origin = createPlot(player)

	local function teleportCharacter(character)
		local root = character:WaitForChild("HumanoidRootPart", 10)

		if root and playerPlots[player.UserId] then
			root.CFrame = CFrame.new(origin + Vector3.new(0, 4, 17))
		end
	end

	if player.Character then
		task.spawn(teleportCharacter, player.Character)
	end

	player.CharacterAdded:Connect(teleportCharacter)
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(loadPlayer, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(loadPlayer, player)
end

Players.PlayerRemoving:Connect(function(player)
	savePlayer(player)

	local plot = playerPlots[player.UserId]

	if plot then
		plot:Destroy()
	end

	playerPlots[player.UserId] = nil
	ownedBusinesses[player.UserId] = nil
	loadedPlayers[player.UserId] = nil
	savingPlayers[player.UserId] = nil
end)

task.spawn(function()
	while true do
		task.wait(INCOME_INTERVAL)

		for _, player in ipairs(Players:GetPlayers()) do
			if loadedPlayers[player.UserId] and ownedBusinesses[player.UserId] then
				local leaderstats = player:FindFirstChild("leaderstats")
				local credits = leaderstats and leaderstats:FindFirstChild("Credits")

				if credits then
					credits.Value += BUSINESS_INCOME
				end
			end
		end
	end
end)

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)

		for _, player in ipairs(Players:GetPlayers()) do
			if loadedPlayers[player.UserId] then
				task.spawn(function()
					savePlayer(player)
				end)
			end
		end
	end
end)

game:BindToClose(function()
	local remaining = 0

	for _, player in ipairs(Players:GetPlayers()) do
		if loadedPlayers[player.UserId] then
			remaining += 1

			task.spawn(function()
				savePlayer(player)
				remaining -= 1
			end)
		end
	end

	local startTime = os.clock()

	while remaining > 0 and os.clock() - startTime < 25 do
		task.wait(0.1)
	end
end)
