	)

	local screenLight = addLight(station, definition.Color, 0.35, 7)

	-- A gentle arm movement suggests the worker is operating equipment.

	local armTween = TweenService:Create(
		rightArm,
		TweenInfo.new(
			1.2,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{
			Position = rightArm.Position + Vector3.new(0, -0.25, -0.25)
		}
	)
	armTween:Play()

	local screenTween = TweenService:Create(
		screenLight,
		TweenInfo.new(
			1.4,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{Brightness = 1}
	)
	screenTween:Play()

	return worker
end

local function ensureWorkers(player)
	local state = playerStates[player.UserId]
	if not state or not state.Plot then
		return
	end

	local workers = state.Plot:FindFirstChild("Workers")
	if not workers then
		workers = Instance.new("Folder")
		workers.Name = "Workers"
		workers.Parent = state.Plot
	end

	for _, definition in ipairs(BUSINESSES) do
		if state.OwnedBusinesses[definition.Id] then
			local count = state.BusinessLevels[definition.Id] or 1
			count = math.min(count, 3)

			for i = 1, count do
				local name = definition.Id .. "_Worker_" .. i
				if not workers:FindFirstChild(name) then
					createWorker(
						state.Plot,
						getOrigin(state),
						definition,
						i
					)
				end
			end
		end
	end
end

-- PLOT AND BUSINESS INTERACTIONS

function getOrigin(state)
	return Vector3.new(state.PlotIndex * PLOT_SPACING, 0, 0)
end

local function makePrompt(target, action, object)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = target
	return prompt
end

local refreshPlot

refreshPlot = function(player)
	local state = playerStates[player.UserId]
	if not state or not state.Plot then
		return
	end

	local plot = state.Plot
	local origin = getOrigin(state)

	for _, folderName in ipairs({"Businesses", "BusinessControls"}) do
		local existing = plot:FindFirstChild(folderName)
		if existing then
			existing:Destroy()
		end
	end

	local buildings = Instance.new("Folder")
	buildings.Name = "Businesses"
	buildings.Parent = plot

	local controls = Instance.new("Folder")
	controls.Name = "BusinessControls"
	controls.Parent = plot

	for index, definition in ipairs(BUSINESSES) do
		local controlPosition = origin + definition.Position
			+ Vector3.new(0, 1.5, 14)

		local control = part(
			controls,
			definition.Id .. "_Control",
			Vector3.new(10, 2, 3),
			controlPosition,
			definition.Color,
			Enum.Material.Neon,
			true
		)

		local owned = state.OwnedBusinesses[definition.Id] == true
		local level = state.BusinessLevels[definition.Id] or 1

		if owned then
			createBuilding(plot, origin, definition, level)

			addLabel(
				control,
				definition.Name,
				"LEVEL " .. level .. " | +" .. incomeFor(definition, level) .. " / 5 SEC",
				definition.Color,
				230
			)

			local action = level >= MAX_LEVEL
				and "MAX LEVEL"
				or "Upgrade: " .. LEVEL_COSTS[level] .. " Credits"

			local prompt = makePrompt(control, action, definition.Name)

			prompt.Triggered:Connect(function(triggeringPlayer)
				if triggeringPlayer ~= player then
					return
				end

				local current = playerStates[player.UserId]
				if not current then
					return
				end

				local currentLevel = current.BusinessLevels[definition.Id] or 1
				if currentLevel >= MAX_LEVEL then
					return
				end

				local cost = LEVEL_COSTS[currentLevel]
				if not cost or not charge(player, cost) then
					return
				end

				current.BusinessLevels[definition.Id] = currentLevel + 1

				if definition.Id == "ServerHub" then
					current.BusinessLevel = currentLevel + 1
				end

				refreshPlot(player)
				ensureWorkers(player)
			end)
		else
			addLabel(
				control,
				definition.Name,
				"COST: " .. definition.Cost .. " CREDITS",
				definition.Color,
				230
			)

			local prompt = makePrompt(
				control,
				"Buy: " .. definition.Cost .. " Credits",
				definition.Name
			)

			prompt.Triggered:Connect(function(triggeringPlayer)
				if triggeringPlayer ~= player then
					return
				end

				local current = playerStates[player.UserId]
				if not current or current.OwnedBusinesses[definition.Id] then
					return
				end

				if index > 1 then
					local previous = BUSINESSES[index - 1]
					if not current.OwnedBusinesses[previous.Id] then
						return
					end
				end

				if not charge(player, definition.Cost) then
					return
				end

				current.OwnedBusinesses[definition.Id] = true
				current.BusinessLevels[definition.Id] = 1

				if definition.Id == "ServerHub" then
					current.OwnsServer = true
					current.BusinessLevel = 1
				end

				refreshPlot(player)
				ensureWorkers(player)
			end)
		end
	end
end

local function createPlot(player)
	local state = playerStates[player.UserId]
	if not state then
		return
	end

	nextPlot += 1
	state.PlotIndex = nextPlot

	local origin = getOrigin(state)

	local plot = Instance.new("Model")
	plot.Name = "CyberCity_" .. player.UserId
	plot.Parent = workspace
	state.Plot = plot

	local ground = part(
		plot,
		"PlotGround",
		Vector3.new(110, 4, 110),
		origin + Vector3.new(0, -1.5, 0),
		Color3.fromRGB(17, 23, 39),
		Enum.Material.Concrete,
		true
	)

	plot.PrimaryPart = ground

	local borderPositions = {
		{Vector3.new(110, 0.8, 0.8), Vector3.new(0, 0.65, -55)},
		{Vector3.new(110, 0.8, 0.8), Vector3.new(0, 0.65, 55)},
		{Vector3.new(0.8, 0.8, 110), Vector3.new(-55, 0.65, 0)},
		{Vector3.new(0.8, 0.8, 110), Vector3.new(55, 0.65, 0)}
	}

	for _, border in ipairs(borderPositions) do
		neon(
			plot,
			"PlotNeonBorder",
			border[1],
			origin + border[2],
			CYAN
		)
	end

	local sign = part(
		plot,
		"OwnerSign",
		Vector3.new(24, 5, 1),
		origin + Vector3.new(0, 4, -48),
		DARK,
		Enum.Material.Metal,
		true
	)

	addLabel(
		sign,
		player.DisplayName .. "'S CYBER CITY",
		"NEON DISTRICT • PRIVATE DEVELOPMENT",
		CYAN,
		300
	)

	createCityEnvironment(plot, origin, state.PlotIndex)
	refreshPlot(player)
	ensureWorkers(player)
end

-- CHARACTER SPAWNING

local function positionCharacter(player, character)
	local state = playerStates[player.UserId]
	if not state then
		return
	end

	local root = character:WaitForChild("HumanoidRootPart", 10)
	local humanoid = character:WaitForChild("Humanoid", 10)

	if not root or not humanoid then
		return
	end

	task.wait(0.2)

	character:PivotTo(CFrame.new(getOrigin(state) + Vector3.new(0, 7, 8)))

	root.Anchored = false
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	humanoid.WalkSpeed = 16
	humanoid.JumpPower = 50
	humanoid.AutoRotate = true
	humanoid.PlatformStand = false
	humanoid.Sit = false

	pcall(function()
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
end

-- SAVE COMPATIBILITY

local function normalizeSave(data)
	data = type(data) == "table" and data or {}

	local credits = tonumber(data.Credits) or STARTING_CREDITS
	local serverLevel = math.clamp(
		tonumber(data.BusinessLevel) or 1,
		1,
		MAX_LEVEL
	)

	local owned = {}
	local levels = {}

	if type(data.OwnedBusinesses) == "table" then
		for id, value in pairs(data.OwnedBusinesses) do
			if getDefinition(id) and value == true then
				owned[id] = true
			end
		end
	end

	if type(data.BusinessLevels) == "table" then
		for id, value in pairs(data.BusinessLevels) do
			if getDefinition(id) then
				levels[id] = math.clamp(tonumber(value) or 1, 1, MAX_LEVEL)
			end
		end
	end

	if data.OwnsServer == true then
		owned.ServerHub = true
		levels.ServerHub = serverLevel
	end

	for id in pairs(owned) do
		levels[id] = levels[id] or 1
	end

	return {
		Credits = math.max(0, credits),
		OwnedBusinesses = owned,
		BusinessLevels = levels,
		OwnsServer = owned.ServerHub == true,
		BusinessLevel = levels.ServerHub or 1
	}
end

local function savePlayer(player)
	local userId = player.UserId
	local state = playerStates[userId]

	if not state or savingPlayers[userId] then
		return false
	end

	savingPlayers[userId] = true

	local data = {
		Credits = state.Credits,
		OwnsServer = state.OwnedBusinesses.ServerHub == true,
		BusinessLevel = state.BusinessLevels.ServerHub or 1,
		OwnedBusinesses = state.OwnedBusinesses,
		BusinessLevels = state.BusinessLevels
	}

	local success, err = pcall(function()
		SaveStore:UpdateAsync("Player_" .. userId, function()
			return data
		end)
	end)

	savingPlayers[userId] = nil

	if not success then
		warn("Cyber City save failed for " .. player.Name .. ": " .. tostring(err))
	end

	return success
end

local function loadPlayer(player)
	local success, data = pcall(function()
		return SaveStore:GetAsync("Player_" .. player.UserId)
	end)

	if not success then
		warn("Cyber City data load failed for " .. player.Name .. ": " .. tostring(data))
		player:Kick("Your saved city could not load. Please check the experience and try again.")
		return
	end

	local saved = normalizeSave(data)

	playerStates[player.UserId] = {
		Credits = saved.Credits,
		OwnsServer = saved.OwnsServer,
		BusinessLevel = saved.BusinessLevel,
		OwnedBusinesses = saved.OwnedBusinesses,
		BusinessLevels = saved.BusinessLevels,
		PlotIndex = 0,
		Plot = nil
	}

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player

	local credits = Instance.new("IntValue")
	credits.Name = "Credits"
	credits.Value = saved.Credits
	credits.Parent = stats

	createPlot(player)

	player.CharacterAdded:Connect(function(character)
		positionCharacter(player, character)
	end)

	if player.Character then
		task.spawn(positionCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(loadPlayer, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(loadPlayer, player)
end

Players.PlayerRemoving:Connect(function(player)
	savePlayer(player)

	local state = playerStates[player.UserId]
	if state and state.Plot then
		state.Plot:Destroy()
	end

	playerStates[player.UserId] = nil
end)

-- PASSIVE BUSINESS INCOME

task.spawn(function()
	while true do
		task.wait(INCOME_INTERVAL)

		for _, player in ipairs(Players:GetPlayers()) do
			local state = playerStates[player.UserId]

			if state then
				local income = getTotalIncome(state)

				if player:GetAttribute("CyberCityVIP") == true then
					income *= VIP_MULTIPLIER
				end

				if income > 0 then
					state.Credits += income
					updateCredits(player)
				end
			end
		end
	end
end)

-- AUTOMATIC SAVING

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)

		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(savePlayer, player)
		end
	end
end)

game:BindToClose(function()
	local pending = 0

	for _, player in ipairs(Players:GetPlayers()) do
		pending += 1

		task.spawn(function()
			local deadline = os.clock() + 20

			while savingPlayers[player.UserId] and os.clock() < deadline do
				task.wait(0.1)
			end

			savePlayer(player)
			pending -= 1
		end)
	end

	local deadline = os.clock() + 25

	while pending > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)

