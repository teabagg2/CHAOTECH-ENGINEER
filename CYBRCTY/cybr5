-- BUSINESS BUILDINGS

local function createBuilding(plot, origin, definition, level)
	local folder = plot:FindFirstChild("Businesses")

	local old = folder:FindFirstChild(definition.Id)
	if old then
		old:Destroy()
	end

	local model = Instance.new("Model")
	model.Name = definition.Id
	model.Parent = folder

	local base = origin + definition.Position
	local width = 18 + (level - 1) * 5
	local depth = 18 + (level - 1) * 4
	local height = 13 + (level - 1) * 9

	-- Foundation and main architectural shell.

	part(
		model,
		"Foundation",
		Vector3.new(width + 3, 1.2, depth + 3),
		base + Vector3.new(0, 1.1, 0),
		Color3.fromRGB(37, 44, 61),
		Enum.Material.Metal,
		true
	)

	local shell = part(
		model,
		"MainBuilding",
		Vector3.new(width, height, depth),
		base + Vector3.new(0, height / 2 + 1.7, 0),
		Color3.fromRGB(19, 29, 48),
		Enum.Material.Metal,
		true
	)

	model.PrimaryPart = shell

	-- Front glass facade, divided into window panels.

	local frontZ = -depth / 2 - 0.15
	local windowColumns = level + 2
	local windowRows = level + 1

	for row = 1, windowRows do
		for column = 1, windowColumns do
			local x = -width / 2 + column * width / (windowColumns + 1)
			local y = 2 + row * (height - 3) / (windowRows + 1)

			local glass = part(
				model,
				"GlassWindow_" .. row .. "_" .. column,
				Vector3.new(2.2, 2.5, 0.25),
				base + Vector3.new(x, y, frontZ),
				GLASS,
				Enum.Material.Glass,
				false
			)
			glass.Transparency = 0.18
			glass.Reflectance = 0.15

			neon(
				model,
				"WindowLight_" .. row .. "_" .. column,
				Vector3.new(1.7, 0.12, 0.12),
				glass.Position + Vector3.new(0, -0.9, -0.16),
				definition.Color
			)
		end
	end

	-- Architectural ribs and illuminated trim.

	for side = -1, 1, 2 do
		part(
			model,
			"StructuralRib",
			Vector3.new(0.8, height, 0.8),
			base + Vector3.new(side * (width / 2 - 0.6), height / 2 + 1.7, frontZ),
			METAL,
			Enum.Material.Metal,
			true
		)

		neon(
			model,
			"VerticalNeon",
			Vector3.new(0.16, height * 0.85, 0.16),
			base + Vector3.new(
				side * (width / 2 - 1.5),
				height / 2 + 1.7,
				frontZ - 0.48
			),
			definition.Color
		)
	end

	neon(
		model,
		"FacadeLight",
		Vector3.new(width * 0.9, 0.25, 0.3),
		base + Vector3.new(0, height * 0.7 + 1.7, frontZ - 0.45),
		definition.Color
	)

	-- Entrance and landing.

	part(
		model,
		"EntranceDoor",
		Vector3.new(3.2, 5, 0.35),
		base + Vector3.new(0, 3.1, frontZ - 0.35),
		Color3.fromRGB(45, 100, 130),
		Enum.Material.Glass,
		false
	)

	neon(
		model,
		"EntranceFrame",
		Vector3.new(4, 0.18, 0.18),
		base + Vector3.new(0, 5.8, frontZ - 0.5),
		definition.Color
	)

	part(
		model,
		"EntrancePlatform",
		Vector3.new(8, 0.5, 5),
		base + Vector3.new(0, 0.9, -depth / 2 - 2),
		Color3.fromRGB(38, 48, 67),
		Enum.Material.Metal,
		true
	)

	-- Roof machinery and antenna.

	part(
		model,
		"RoofDeck",
		Vector3.new(width + 2, 0.7, depth + 2),
		base + Vector3.new(0, height + 2.1, 0),
		DARK,
		Enum.Material.Metal,
		true
	)

	for i = 1, level + 1 do
		local rooftop = part(
			model,
			"RoofMachine_" .. i,
			Vector3.new(2.5, 2 + level, 2.5),
			base + Vector3.new(
				-width / 3 + i * width / (level + 2),
				height + 3.5 + (level / 2),
				1
			),
			METAL,
			Enum.Material.Metal,
			true
		)

		neon(
			model,
			"MachineLight_" .. i,
			Vector3.new(2, 0.18, 2),
			rooftop.Position + Vector3.new(0, 0.7 + level / 2, 0),
			definition.Color
		)
	end

	if level >= 2 then
		local upperHeight = height * 0.4
		local upperWidth = width * 0.65
		local upperDepth = depth * 0.65

		local upper = part(
			model,
			"ExecutiveUpperFloor",
			Vector3.new(upperWidth, upperHeight, upperDepth),
			base + Vector3.new(0, height + upperHeight / 2 + 2.5, 0),
			Color3.fromRGB(14, 22, 42),
			Enum.Material.Metal,
			true
		)

		for column = 1, 3 do
			local x = (column - 2) * upperWidth / 3

			part(
				model,
				"UpperGlass_" .. column,
				Vector3.new(2.5, upperHeight * 0.55, 0.25),
				upper.Position + Vector3.new(
					x,
					0,
					-upperDepth / 2 - 0.15
				),
				GLASS,
				Enum.Material.Glass,
				false
			)
		end

		neon(
			model,
			"UpperRoofRim",
			Vector3.new(upperWidth + 1, 0.3, upperDepth + 1),
			upper.Position + Vector3.new(0, upperHeight / 2 + 0.2, 0),
			definition.Color
		)
	end

	if level >= 3 then
		local tower = part(
			model,
			"CorporateSignalTower",
			Vector3.new(6, 15, 6),
			base + Vector3.new(0, height + height * 0.4 + 10, 0),
			Color3.fromRGB(12, 19, 36),
			Enum.Material.Metal,
			true
		)

		for i = 1, 4 do
			local angle = math.rad(i * 90)

			neon(
				model,
				"TowerStrip_" .. i,
				Vector3.new(0.25, 12, 0.25),
				tower.Position + Vector3.new(
					math.cos(angle) * 3,
					0,
					math.sin(angle) * 3
				),
				definition.Color
			)
		end

		local core = neon(
			model,
			"FloatingEnergyCore",
			Vector3.new(3.5, 3.5, 3.5),
			tower.Position + Vector3.new(0, 9, 0),
			definition.Color
		)
		core.Shape = Enum.PartType.Ball
		addLight(core, definition.Color, 2, 20)
		animatePulse(core, 3.5, Vector3.new(4.5, 4.5, 4.5))

		local antenna = neon(
			model,
			"BroadcastAntenna",
			Vector3.new(0.35, 8, 0.35),
			tower.Position + Vector3.new(0, 13, 0),
			PINK
		)
		addLight(antenna, PINK, 1, 15)
	end

	-- Holographic company sign.

	local sign = part(
		model,
		"CompanySign",
		Vector3.new(math.min(width - 2, 15), 2.2, 0.25),
		base + Vector3.new(0, height - 2, frontZ - 0.6),
		DARK,
		Enum.Material.Metal,
		false
	)

	addLabel(
		sign,
		definition.Name,
		"LEVEL " .. level .. "  |  +" .. incomeFor(definition, level) .. " CREDITS / 5 SEC",
		definition.Color,
		250
	)

	addLight(shell, definition.Color, 0.25, 12)
end

