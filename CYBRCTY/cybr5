-- GENERAL BUILDING TOOLS

local function part(parent, name, size, position, color, material, collidable)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.Position = position
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = collidable == true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CastShadow = true
	object.Parent = parent
	return object
end

local function neon(parent, name, size, position, color)
	local object = part(
		parent,
		name,
		size,
		position,
		color,
		Enum.Material.Neon,
		false
	)
	object.CastShadow = false
	return object
end

local function addLabel(target, title, subtitle, color, width)
	local gui = Instance.new("BillboardGui")
	gui.Name = "CyberHologram"
	gui.Size = UDim2.fromOffset(width or 240, 72)
	gui.StudsOffset = Vector3.new(0, 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 180
	gui.Parent = target

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, 0, 0.58, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = title
	titleLabel.TextColor3 = color
	titleLabel.TextStrokeTransparency = 0.25
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextScaled = true
	titleLabel.Parent = gui

	local subLabel = Instance.new("TextLabel")
	subLabel.Position = UDim2.new(0, 0, 0.58, 0)
	subLabel.Size = UDim2.new(1, 0, 0.35, 0)
	subLabel.BackgroundTransparency = 1
	subLabel.Text = subtitle
	subLabel.TextColor3 = Color3.fromRGB(220, 235, 255)
	subLabel.TextStrokeTransparency = 0.4
	subLabel.Font = Enum.Font.GothamMedium
	subLabel.TextScaled = true
	subLabel.Parent = gui

	return gui
end

local function addLight(target, color, brightness, range)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = target
	return light
end

local function animatePulse(object, smallSize, largeSize)
	TweenService:Create(
		object,
		TweenInfo.new(
			1.8,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{
			Size = largeSize,
			Transparency = 0.2
		}
	):Play()
end

local function getDefinition(id)
	for _, definition in ipairs(BUSINESSES) do
		if definition.Id == id then
			return definition
		end
	end
end

local function incomeFor(definition, level)
	return definition.BaseIncome * (LEVEL_MULTIPLIERS[level] or 1)
end

local function getTotalIncome(state)
	local total = 0

	for id, owned in pairs(state.OwnedBusinesses) do
		if owned then
			local definition = getDefinition(id)
			if definition then
				total += incomeFor(
					definition,
					state.BusinessLevels[id] or 1
				)
			end
		end
	end

	return total
end

local function updateCredits(player)
	local state = playerStates[player.UserId]
	if not state then
		return
	end

	local stats = player:FindFirstChild("leaderstats")
	local credits = stats and stats:FindFirstChild("Credits")

	if credits then
		credits.Value = state.Credits
	end
end

local function charge(player, amount)
	local state = playerStates[player.UserId]
	if not state or amount < 0 or state.Credits < amount then
		return false
	end

	state.Credits -= amount
	updateCredits(player)
	return true
end

